{
  "name": "lesson-booking",
  "private": true,
  "version": "0.1.0",
  "description": "レッスン予約サービス バックエンド(Googleカレンダー複数連携・直前変更の主催者承認制)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "build:all": "npm run build && npm --prefix web run build",
    "test:e2e": "npm run build:all && playwright test"
  },
  "dependencies": {
    "@googleapis/calendar": "^20.0.1",
    "@supabase/supabase-js": "^2.110.0",
    "express": "^5.1.0",
    "google-auth-library": "^11.1.0",
    "jose": "^6.1.0",
    "stripe": "^22.6.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
