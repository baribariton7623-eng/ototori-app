# --- サーバー ---
PORT=8787
# dev: x-dev-user-email / x-dev-role ヘッダで認証を代替(ローカル専用)
# supabase: Authorization: Bearer <Supabase Auth JWT> を検証
AUTH_MODE=dev
# memory: インメモリ(再起動で消える) / supabase: Postgres(Supabase)
STORAGE=memory
# fake: Googleカレンダーを呼ばず空busyとして扱う / google: 実際のGoogle Calendar APIを使う
CALENDAR=fake
TIMEZONE=Asia/Tokyo
# フロントエンドのビルド成果物。存在すれば同じサーバーで配信する(cd web && npm run build)
WEB_DIST=web/dist

# フロントエンドの公開 URL(公開予約ページ URL と課金のリダイレクトに使う。末尾スラッシュなし)
APP_BASE_URL=http://localhost:8787

# --- 通知メール ---
SERVICE_NAME=レッスン予約
# console: 送らずにサーバーログへ出す(ローカル用) / resend: Resend で送信
MAIL=console
RESEND_API_KEY=
# 送信元。ドメインは Resend で DNS 認証(SPF/DKIM)済みであること
MAIL_FROM="レッスン予約 <noreply@example.com>"

# --- 前日リマインド ---
# 外部 cron(Render Cron Job / GitHub Actions / cron-job.org 等)から毎時
#   curl -X POST -H "x-cron-secret: $CRON_SECRET" https://<api>/internal/cron/reminders
# を叩く。サーバーが 1 台なら REMINDER_INTERVAL_MINUTES=60 でサーバー内実行でもよい
CRON_SECRET=
REMINDER_HOURS_BEFORE=24
REMINDER_INTERVAL_MINUTES=0

# --- 課金 ---
# fake: Stripe を使わず即時有効化(ローカル用) / stripe: Stripe Checkout + Webhook
BILLING=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
# 教室プラン: 講師 1 人あたり月額の Price(数量 = 所属講師数)
STRIPE_PRICE_ID_ORG_SEAT=
# キャンセルフィー決済(Connect)用。Stripe ダッシュボードで「連結アカウント」のイベントを受ける
# Webhook を /billing/connect-webhook に別途登録し、その署名シークレットを入れる
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Supabase(STORAGE=supabase または AUTH_MODE=supabase のとき) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Google OAuth(CALENDAR=google のとき) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/google/callback
# Google 連携の手続きに署名する鍵(32 文字以上のランダム文字列。本番では必須)
#   生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=
