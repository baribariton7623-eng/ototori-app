# --- サーバー ---
PORT=8787
# dev: x-dev-user-email / x-dev-role ヘッダで認証を代替(ローカル専用)
# supabase: Authorization: Bearer <Supabase Auth JWT> を検証
AUTH_MODE=dev
# memory: インメモリ(再起動で消える) / supabase: Postgres(Supabase)
STORAGE=memory
# fake: Googleカレンダーを呼ばず空busyとして扱う / google: 実際のGoogle Calendar APIを使う
CALENDAR=fake
TIMEZONE=Asia/Tokyo

# --- Supabase(STORAGE=supabase または AUTH_MODE=supabase のとき) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Google OAuth(CALENDAR=google のとき) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/google/callback
