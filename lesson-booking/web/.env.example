# AUTH_MODE と合わせる: dev(メールを入力してログイン代替) / supabase(Supabase Auth + Google ログイン)
VITE_AUTH_MODE=dev
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- 運営者情報(利用規約・プライバシーポリシー・特定商取引法に基づく表記に表示) ---
# 未設定の項目は各ページに赤字で「未設定」と表示される
VITE_SERVICE_NAME=レッスン予約
VITE_OPERATOR_NAME=
VITE_OPERATOR_REPRESENTATIVE=
# 個人事業主は「請求があった場合には遅滞なく開示いたします」と記載することもできる
VITE_OPERATOR_ADDRESS=
VITE_OPERATOR_PHONE=
VITE_OPERATOR_EMAIL=
VITE_PRO_PRICE=月額1,480円(税込)
VITE_ORG_SEAT_PRICE=講師1人あたり月額1,280円(税込)
VITE_LEGAL_EFFECTIVE_DATE=
